  "coverage_gaps": [
    {
      "id": "kevin-jennings-missing-from-seeds",
      "summary": "Kevin Jennings was absent from repo seeds/fixtures before this cohort; Find Player returned zero results when the live athletes table lacked him or roster_verified_at was stale.",
      "remediation": [
        "Run scripts/seed_smu_demo_cohort.py (roster sync team 2567 for cfb + ncaab_mens).",
        "Or POST /v1/scraper/jobs/roster-sync with {\"sport\":\"cfb\",\"team_ids\":[\"2567\"]} then ncaab_mens.",
        "Confirm: SELECT name, sport, espn_id, roster_verified_at, roster_status FROM athletes WHERE espn_id = '5084084';",
        "Rescore / gap-fill before Brand Match or CSC if gravity_scores are missing."
      ]
    },
    {
      "id": "smu-wbb-empty-espn-roster",
      "summary": "SMU women's basketball ESPN roster endpoints returned zero athletes.",
      "remediation": [
        "Skip NCAAW for SMU demos.",
        "Re-check ESPN roster after season publication; then re-run seed script with --include-wbb when payloads are non-empty."
      ]
    },
    {
      "id": "brand-match-needs-scores-and-social",
      "summary": "Roster sync alone does not guarantee Brand Match hits; engine needs gravity scores, risk, and social/DQS signals.",
      "remediation": [
        "After roster sync, run gap-fill + score for curated espn_ids (or full SMU team).",
        "For apparel demos prefer skill players (WR/RB/QB) with social reach; use National geography if ACC/Texas geo filters zero out."
      ]
    },
    {
      "id": "capiq-org-vs-profile-label",
      "summary": "Settings org_name 'SMU' is not CapIQ membership; CapIQ needs organization_id linked.",
      "remediation": [
        "Use smu@gravity.local (demo school admin) after seed_demo_accounts + SMU org membership, or link an SMU organization explicitly.",
        "Do not present illustrative cap dollars as SMU budget when unlinked."
      ]
    }
  ],
